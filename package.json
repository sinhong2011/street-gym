{
  "name": "street-gym",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "studio": "remotion studio src/remotion/index.ts",
    "render:hero": "remotion render src/remotion/index.ts Hero out/hero.mp4",
    "deploy": "pnpm build && pnpm dlx wrangler@latest pages deploy dist --project-name street-gym --branch main"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "@remotion/player": "4.0.532",
    "@remotion/three": "4.0.532",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.532",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.532",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "packageManager": "pnpm@12.7.0"
}
